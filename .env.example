# FYERS API v3 (free Standard plan; individual-app access token expires daily at 06:30).
# Create an individual app in the FYERS API dashboard and follow its OAuth flow.
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=
# Defaults are set for the common NSE index symbols. Extend/override symbols if needed.
FYERS_SYMBOL_MAP={"NIFTY":"NSE:NIFTY50-INDEX","BANKNIFTY":"NSE:NIFTYBANK-INDEX","FINNIFTY":"NSE:FINNIFTY-INDEX","MIDCPNIFTY":"NSE:MIDCPNIFTY-INDEX"}

# Annual decimal rate assumption. Configure the Indian short-term rate suitable for the analysis.
INDIA_RISK_FREE_RATE=0.065
DAY_COUNT_BASIS=365
MAX_CHAIN_AGE_SECONDS=300
CHAIN_CACHE_TTL_SECONDS=30
DEFAULT_DATA_SOURCE=auto
# Optional lot sizes if a selected response does not provide them, e.g. {"RELIANCE":250}.
NSE_LOT_SIZES={}
# NSE holidays are maintained in data/nse_holidays.csv; add exceptional closures YYYY-MM-DD, comma-separated.
NSE_HOLIDAYS_EXTRA=
CHAIN_CACHE_DIR=.cache/chains
